---
# Claude Code Automated PR Review Workflow (template)
#
# How to enable:
#   1. Copy: cp .github/workflows/claude-review.yml.template .github/workflows/claude-review.yml
#   2. Add ANTHROPIC_API_KEY to GitHub repository Secrets
#   3. See .github/CLAUDE_REVIEW_SETUP.md for full details
#
# Triggers: `@claude` mention in a PR comment, or on PR open (optional)
#
# Cost note: Configure monthly/daily spend limits on the API key (see SETUP.md)

name: Claude Code Review

on:
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]
  pull_request:
    types: [opened, synchronize]

jobs:
  claude-review:
    # Only run on @claude mentions or non-draft PR events
    if: >
      (github.event_name == 'issue_comment' && contains(github.event.comment.body, '@claude')) ||
      (github.event_name == 'pull_request_review_comment' && contains(github.event.comment.body, '@claude')) ||
      (github.event_name == 'pull_request' && github.event.pull_request.draft == false)
    runs-on: ubuntu-latest

    # Least privilege: only PR-write and comment-add
    permissions:
      contents: read
      pull-requests: write
      issues: write
      id-token: write   # required for the default GitHub App authentication
      actions: read     # lets Claude read the PR's CI results

    timeout-minutes: 15

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 1

      - name: Claude Code Review
        uses: anthropics/claude-code-action@v1
        with:
          anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}
          # v1 inputs are prompt / claude_args. The beta-era model / max_turns / direct_prompt inputs are not accepted
          # Model (cost / quality trade-off):
          # - claude-opus-5-5: high-quality review, high cost
          # - claude-sonnet-5: standard review (recommended)
          # - claude-haiku-4-5-20251001: lightweight review, quick checks
          # --max-turns is the cost guardrail (runaway protection)
          claude_args: "--model claude-sonnet-5 --max-turns 10"
          # Review instructions (project-specific axes). With a prompt set, the action runs without waiting for @claude
          prompt: |
            This repo follows the conventions in `AGENTS.md`, `CLAUDE.md`, and `project-config.md`.
            Review the PR on these axes:

            1. **Design**: architecture violations, dependency-direction violations
            2. **Security**: OWASP Top 10, leaked secrets, input validation
            3. **Tests**: coverage, edge cases, TDD alignment
            4. **Readability**: naming, comments, separation of concerns
            5. **Known pitfalls**: any case matching `.claude/pitfalls.md`

            Classify findings as CRITICAL / HIGH / MEDIUM / LOW / INFO,
            and propose fixes as concrete diff suggestions.

            The project's default language is English; return review comments in English.
