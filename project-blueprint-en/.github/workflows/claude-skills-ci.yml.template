---
# Claude Code Skills CI (template)
#
# Runs the blueprint's skills deterministically on every PR via `claude -p` (headless).
#
# How this differs from claude-review.yml:
#   claude-review.yml    … conversational review triggered by an `@claude` mention (human-initiated)
#   claude-skills-ci.yml … always runs /code-review and /security-scan on every PR (automatic)
#
# Enable it:
#   1. cp .github/workflows/claude-skills-ci.yml.template .github/workflows/claude-skills-ci.yml
#   2. Add ANTHROPIC_API_KEY to the repository Secrets
#   3. Set a spend limit in the Claude Console (see .github/CLAUDE_REVIEW_SETUP.md)
#
# Cost: two skill runs per PR. Bound it with --model and --max-turns.
#
# Security:
#   - Never interpolate untrusted input (PR title/body) into `run:` (command injection)
#   - `--permission-mode dontAsk` auto-denies anything not in the allow list
#   - Forked PRs receive no secrets, so this workflow skips them

name: Claude Skills CI

on:
  pull_request:
    types: [opened, synchronize, reopened]

permissions:
  contents: read
  pull-requests: write

concurrency:
  group: claude-skills-ci-${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  skills:
    # Skip drafts and forked PRs (no secrets available)
    if: >
      github.event.pull_request.draft == false &&
      github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-latest
    timeout-minutes: 25

    env:
      ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
      # Pass hooks through in CI: no outbound notifications, less runtime
      BLUEPRINT_HOOK_PROFILE: minimal
      # Disable cross-session auto memory so runs are reproducible
      CLAUDE_CODE_DISABLE_AUTO_MEMORY: "1"
      # Shared permission set. Under dontAsk this is the only allow list in effect.
      CLAUDE_ALLOWED_TOOLS: >-
        Read,Grep,Glob,
        Bash(git diff *),Bash(git log *),Bash(git status *),Bash(git rev-parse *),
        Edit(output/**),Edit(testreport/**)

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          # Fetch the base branch so the diff review has something to compare against
          fetch-depth: 0

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: "22"

      - name: Install Claude Code
        run: npm install -g @anthropic-ai/claude-code@2

      - name: Prepare output directories
        run: mkdir -p output/reports/review output/reports/security testreport/security

      # No --bare here: the project's .claude/ (skills / settings / hooks) must load.
      - name: Run /code-review
        run: |
          claude -p "/code-review Review the changes in this PR and save the result as Markdown under output/reports/review/." \
            --permission-mode dontAsk \
            --allowedTools "${CLAUDE_ALLOWED_TOOLS}" \
            --model sonnet \
            --max-turns 30 \
            --output-format text \
            | tee output/reports/review/_ci-stdout.md

      - name: Run /security-scan
        run: |
          claude -p "/security-scan Audit this repository's dependencies and code, and save the result as Markdown under output/reports/security/." \
            --permission-mode dontAsk \
            --allowedTools "${CLAUDE_ALLOWED_TOOLS}" \
            --model sonnet \
            --max-turns 30 \
            --output-format text \
            | tee output/reports/security/_ci-stdout.md

      - name: Upload reports
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: claude-skill-reports
          path: |
            output/reports/
            testreport/
          retention-days: 14

      - name: Compose PR comment
        if: always()
        run: |
          {
            echo "## 🤖 Claude Skills CI"
            echo
            echo "### /code-review"
            echo
            cat output/reports/review/_ci-stdout.md 2>/dev/null || echo "_(no output)_"
            echo
            echo "### /security-scan"
            echo
            cat output/reports/security/_ci-stdout.md 2>/dev/null || echo "_(no output)_"
            echo
            echo "---"
            echo "Full reports are in the \`claude-skill-reports\` artifact on this run."
          } > /tmp/claude-ci-comment.md
          # Keep within GitHub's comment size limit
          head -c 60000 /tmp/claude-ci-comment.md > /tmp/claude-ci-comment.trimmed.md

      - name: Post PR comment
        if: always()
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
        run: gh pr comment "$PR_NUMBER" --body-file /tmp/claude-ci-comment.trimmed.md
