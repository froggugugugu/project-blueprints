# ==============================================================================
# default.rules — Codex command rules (the layer matching Claude Code's permissions.deny / ask)
#
# Mapping: deny in .claude/settings.json → decision = "forbidden" / ask → decision = "prompt".
# When you change one side, change the other to the same intent (scripts/validate-harness.sh checks for gaps).
#
# A rule can only match a command prefix. The following cannot be expressed here and are stopped
# by the shared hook (.agents/hooks/safety-check.sh) with regular expressions:
#   - dangerous flags in the middle or at the end of the arguments (`git push origin main --force`, `<anything> --no-verify`)
#   - piping into a shell (`curl ... | sh`)
# Secret-read denial (Claude Code's Read() deny) is done by the permission profile in .codex/config.toml.
#
# Check: codex execpolicy check --pretty --rules .codex/rules/default.rules -- git push origin main
# Spec: https://developers.openai.com/codex/rules (rules are experimental)
# ==============================================================================

# ── Forbidden (rejected without a prompt) ──────────────────────────────────

prefix_rule(
    pattern = ["rm", ["-rf", "-fr"]],
    decision = "forbidden",
    justification = "Recursive forced deletion is forbidden. Name the targets individually or ask a human",
    match = ["rm -rf build", "rm -fr tmp"],
    not_match = ["rm build/a.txt"],
)

prefix_rule(
    pattern = ["git", "push", ["--force", "-f", "--force-with-lease"]],
    decision = "forbidden",
    justification = "Force push is forbidden (it rewrites history). A human runs it when needed",
    match = ["git push --force origin main", "git push -f"],
    not_match = ["git push origin main"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Discards the working tree. A human runs it when needed",
    match = ["git reset --hard HEAD~1"],
    not_match = ["git reset --soft HEAD~1"],
)

prefix_rule(
    pattern = ["git", "clean", ["-f", "-fd", "-fdx", "-fx", "-df", "-xf", "-xdf", "-dfx"]],
    decision = "forbidden",
    justification = "Deletes untracked files. A human runs it when needed",
    match = ["git clean -fd"],
    not_match = ["git clean -n"],
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "Privilege escalation is forbidden",
    match = ["sudo ls"],
)

prefix_rule(
    pattern = ["chmod", "777"],
    decision = "forbidden",
    justification = "World-writable permissions are forbidden. Grant the minimum needed",
    match = ["chmod 777 run.sh"],
    not_match = ["chmod 755 run.sh"],
)

prefix_rule(
    pattern = ["dd"],
    decision = "forbidden",
    justification = "Writing to a disk directly is forbidden",
    match = ["dd if=/dev/zero of=disk.img"],
)

prefix_rule(
    pattern = [["mkfs", "mkfs.ext4", "mkfs.xfs", "mkfs.btrfs", "mkfs.vfat"]],
    decision = "forbidden",
    justification = "Creating a filesystem is forbidden",
    match = ["mkfs.ext4 /dev/sdz1"],
)

prefix_rule(
    pattern = ["git", ["commit", "push", "merge"], "--no-verify"],
    decision = "forbidden",
    justification = "Bypassing git hooks is forbidden. Fix the failing hook",
    match = ["git commit --no-verify -m x"],
    not_match = ["git commit -m x"],
)

# ── Prompt every time (outbound or irreversible operations) ────────────────

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Confirm every push to a remote",
    match = ["git push origin main"],
    not_match = ["git status"],
)

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "prompt",
    justification = "Confirm every PR merge",
    match = ["gh pr merge 12 --squash"],
    not_match = ["gh pr view 12"],
)

prefix_rule(
    pattern = ["gh", "release"],
    decision = "prompt",
    justification = "Confirm every release creation or change",
    match = ["gh release create v1.0.0"],
)

prefix_rule(
    pattern = ["gh", "repo", "delete"],
    decision = "prompt",
    justification = "Confirm every repository deletion",
    match = ["gh repo delete owner/name"],
)

prefix_rule(
    pattern = [["npm", "yarn", "pnpm"], "publish"],
    decision = "prompt",
    justification = "Confirm every package publish",
    match = ["npm publish", "pnpm publish --tag next"],
    not_match = ["npm test"],
)

prefix_rule(
    pattern = ["docker", "push"],
    decision = "prompt",
    justification = "Confirm every image push",
    match = ["docker push app:latest"],
    not_match = ["docker build ."],
)

prefix_rule(
    pattern = ["kubectl", ["apply", "delete"]],
    decision = "prompt",
    justification = "Confirm every apply or delete against a cluster",
    match = ["kubectl apply -f k8s/"],
    not_match = ["kubectl get pods"],
)

prefix_rule(
    pattern = ["terraform", ["apply", "destroy"]],
    decision = "prompt",
    justification = "Confirm every infrastructure apply or destroy",
    match = ["terraform apply"],
    not_match = ["terraform plan"],
)

prefix_rule(
    pattern = [["curl", "wget"]],
    decision = "prompt",
    justification = "Confirm every outbound request",
    match = ["curl https://example.com", "wget https://example.com/a"],
)
