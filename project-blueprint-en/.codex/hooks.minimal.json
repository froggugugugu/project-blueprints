{
  "description": "Project Blueprint (minimal): registers only the two blocking hooks. Review and trust them with /hooks in Codex on first use and after every change",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.agents/hooks/lib/codex-adapter.sh\" --fail-closed safety-check.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.agents/hooks/lib/codex-adapter.sh\" --fail-closed protect-files.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
