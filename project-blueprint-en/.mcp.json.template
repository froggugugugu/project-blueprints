{
  "$schema": "https://json.schemastore.org/mcp.json",
  "_comment_usage": "Template for project-shared MCP server definitions. Copy and rename this file to `.mcp.json` to activate. Credentials must be injected via environment variables; never hard-code them. Remove blocks for servers you don't use.",
  "mcpServers": {
    "context7": {
      "_comment": "Official documentation / API reference retrieval. Complement WebFetch when needed",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@4.4.4"
      ],
      "_verify": "Versions are pinned as a supply-chain measure (latest as of 2026-11-01). To update, check `npm view @upstash/context7-mcp version` and verify resolution with `bash scripts/validate-harness.sh --online`",
      "_plugin_overlap": "When the context7 plugin is enabled in settings.json enabledPlugins, the official remote MCP (mcp.context7.com) is connected. Remove this block in that case to avoid a duplicate server"
    },
    "playwright": {
      "_comment": "Browser automation / E2E test debugging",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.84"
      ]
    },
    "github": {
      "_comment": "GitHub API (Issues / PR / Actions). GitHub's official remote MCP server. Export $GITHUB_TOKEN first. Keep scopes minimal (repo:status, public_repo)",
      "_note": "The old stdio package @modelcontextprotocol/server-github is deprecated on npm; this uses the official remote server instead",
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      }
    }
  },
  "_comment_security": [
    "MCP servers can execute arbitrary commands. Use only trusted sources",
    "Inject credentials via environment variables (${VAR_NAME}); never hard-code them in JSON",
    "In settings.local.json permissions.allow, explicitly allow MCP(server:<name>)",
    "For write-capable servers like postgres, deny by default and enable only read-only access"
  ],
  "_comment_optional_servers": {
    "_comment_priority": [
      "Recommendation tiers (high -> low):",
      "  ★★★ filesystem: Efficient file traversal in large repos (fallback for Read/Glob)",
      "  ★★★ sentry: Continuous monitoring of production errors and performance",
      "  ★★☆ brave-search: WebSearch alternative (works without API key, rate-limited)",
      "  ★★☆ postgres: Read-only schema introspection (NEVER point to a production DSN)",
      "  ★☆☆ slack: Team notification automation (mis-post risk; minimize scopes)",
      "  ⚠️  Pin every npx-launched package as name@x.y.z (validate-harness.sh flags unpinned ones). Check updates with npm view <name> version"
    ],
    "filesystem": {
      "_verify": "Run `npm view @modelcontextprotocol/server-filesystem version` and bump the `name@x.y.z` pin (2.1.0 is the latest as of 2026-11-01)",
      "_warning": "The MCP filesystem server can traverse everything under the given root. Scoping is done by **listing only the safe subdirectories as positional arguments** — the server has no CLI-level exclude flag (as of 2026-04). Use multiple defense layers for secret protection:",
      "_protection_layers": [
        "1) Restrict exposed dirs: pass only secret-free subtrees like `${PROJECT_ROOT}/src` as args",
        "2) protect-files.sh hook (bundled in this template) blocks Read/Edit on `.env`, private keys, etc. even via MCP",
        "3) For servers that should respect `.gitignore`, use a wrapper layer separately"
      ],
      "_recommended_for": "Repositories with >100k lines where Read/Glob token efficiency matters",
      "_example_safe": {
        "_note": "Recommended: pass only secret-free subdirs as positional args",
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-filesystem@2.1.0",
          "${PROJECT_ROOT}/src",
          "${PROJECT_ROOT}/docs",
          "${PROJECT_ROOT}/tests"
        ]
      },
      "_example_full_root_with_hooks": {
        "_note": "Passing the full root requires the protect-files.sh / safety-check.sh hooks to be active",
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-filesystem@2.1.0",
          "${PROJECT_ROOT}"
        ]
      }
    },
    "postgres": {
      "_warning": "Direct DB access is high risk. Use read-only only; never point to a production DSN",
      "_example": {
        "command": "npx",
        "args": [
          "-y",
          "@bytebase/dbhub@1.5.0",
          "--readonly",
          "--transport",
          "stdio",
          "--dsn",
          "${DATABASE_URL}"
        ]
      },
      "_note": "The old @modelcontextprotocol/server-postgres is deprecated on npm (removed from the official repository). Replaced by DBHub (PostgreSQL / MySQL / SQL Server / SQLite / DuckDB). `--readonly` is a SQL keyword allowlist that was bypassable before 0.22.6 (CVE-2026-61788), so also connect with a database role that has SELECT only"
    },
    "sentry": {
      "_warning": "Useful for production error investigation. Export $SENTRY_AUTH_TOKEN first",
      "_recommended_for": "Production phase. Useful for /security-scan and /code-review to fetch error context",
      "_example": {
        "command": "npx",
        "args": [
          "-y",
          "@sentry/mcp-server@0.42.0"
        ],
        "env": {
          "SENTRY_AUTH_TOKEN": "${SENTRY_AUTH_TOKEN}"
        }
      },
      "_note": "Sentry's official remote MCP (https://mcp.sentry.dev/mcp, OAuth) offers the same tools; prefer it when you do not want a token on the machine"
    },
    "brave-search": {
      "_warning": "Web search alternative. Export $BRAVE_API_KEY (free tier available). Useful when WebSearch is unavailable",
      "_recommended_for": "Air-gapped / corporate environments where WebSearch is restricted",
      "_example": {
        "command": "npx",
        "args": [
          "-y",
          "@brave/brave-search-mcp-server@2.1.4"
        ],
        "env": {
          "BRAVE_API_KEY": "${BRAVE_API_KEY}"
        }
      },
      "_note": "Moved to Brave's official MCP server. The old @modelcontextprotocol/server-brave-search is deprecated on npm"
    },
    "slack": {
      "_warning": "Chat notifications and sharing. Because of the mis-post risk, confirm write tools (sending messages) through permissions.ask every time and have a workspace admin approve the MCP client",
      "_example": {
        "type": "http",
        "url": "https://mcp.slack.com/mcp"
      },
      "_note": "Slack's official remote MCP server (GA 2026-02, OAuth; the first connection authorizes in the browser, Streamable HTTP only). Replaces the deprecated @modelcontextprotocol/server-slack npm package. Only Marketplace-listed or internal apps can connect"
    },
    "_comment_fetch_removed": "Use Claude Code's built-in WebFetch tool for web retrieval. The previously listed @modelcontextprotocol/server-fetch does not exist on npm (checked 2026-08) and was removed."
  }
}
