# ============================================================
# project-blueprint-en .gitignore
# ============================================================

# --- Claude Code local settings (user-specific permissions) ---
.claude/settings.local.json

# --- Tool raw output (machine-generated, not for review) ---
# Note: observability hooks (post-failure-log.sh, subagent-audit.sh) write
# .jsonl files under testreport/; pre-compact-backup.sh writes .md transcripts.
# These may contain PII, secrets, or tool_input payloads — exclude them from Git.
testreport/**/*.html
testreport/**/*.json
testreport/**/*.jsonl
testreport/**/*.lcov
testreport/**/*.md
testreport/**/*.xml
!testreport/**/.gitkeep

# --- Environment & secrets ---
.env
.env.*
!.env.example

# --- OS ---
.DS_Store
Thumbs.db

# --- Editor ---
*.swp
*.swo
*~

# --- Node (if used in target project) ---
node_modules/
dist/
.cache/
