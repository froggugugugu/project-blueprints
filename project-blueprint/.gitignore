# ============================================================
# project-blueprint .gitignore
# ============================================================

# --- Claude Code local settings (user-specific permissions) ---
.claude/settings.local.json

# --- Tool raw output (machine-generated, not for review) ---
testreport/**/*.html
testreport/**/*.json
testreport/**/*.lcov
testreport/**/*.xml
!testreport/**/.gitkeep

# --- Environment & secrets ---
.env
.env.*
!.env.example

# --- OS ---
.DS_Store
Thumbs.db

# --- Editor ---
*.swp
*.swo
*~

# --- Node (if used in target project) ---
node_modules/
dist/
.cache/
